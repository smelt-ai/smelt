# Rust 构建产物
/target

# rustfmt 备份文件
**/*.rs.bk

# 本地环境与密钥（绝不入库）
.env

# 注意：Cargo.lock 对二进制（bin）项目应保留，故此处不忽略。

# 打包产物
dist/

# macOS 目录元数据
.DS_Store

# Java 语言服务生成的 Android IDE 配置
/mobile/android/.project
/mobile/android/.settings/
/mobile/rust_builder/android/.project
/mobile/rust_builder/android/.settings/

# Python 脚本缓存
__pycache__/

# 自带插件（plugins/<name>/）：开发时用 smelt plugin types 生成的 NSH 类型声明与 tsconfig，不是插件内容。
/plugins/*/.nsh/
/plugins/*/tsconfig.json
/plugins/*/node_modules/

# 本地手测用的一次性文件
/mermaid-test.md

# TS 包（agent）的依赖树，不入库。
agent/node_modules/

# npm pack 产物（本地验证发布内容时会生成）
*.tgz

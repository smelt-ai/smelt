{
  "version": 1,
  "name": "Spaceduck",
  "author": "Guillermo Rodriguez",
  "url": "https://github.com/pineapplegiant/spaceduck",
  "themes": [
    {
      "name": "Spaceduck",
      "mode": "dark",
      "colors": {
        "bg_base": "#0F111B",
        "text_base": "#A3A49D",
        "bg_accent": "#089CC5",
        "info.fg": "#00A3CC",
        "success.fg": "#5CCC96",
        "warning.fg": "#B89C00",
        "danger.fg": "#E33400"
      },
      "syntax": {
        "attribute": {
          "color": "#F2CE00"
        },
        "boolean": {
          "color": "#F2CE00"
        },
        "comment": {
          "color": "#4B6479",
          "font_style": "italic"
        },
        "comment.doc": {
          "color": "#4B6479",
          "font_style": "italic"
        },
        "constant": {
          "color": "#E33400"
        },
        "constructor": {
          "color": "#5CCC96"
        },
        "embedded": {
          "color": "#ECF0C1"
        },
        "function": {
          "color": "#089CC5"
        },
        "keyword": {
          "color": "#C86D8C"
        },
        "link_text": {
          "color": "#089CC5",
          "font_style": "underline"
        },
        "link_uri": {
          "color": "#089CC5",
          "font_style": "italic"
        },
        "number": {
          "color": "#F2CE00"
        },
        "string": {
          "color": "#5CCC96"
        },
        "string.escape": {
          "color": "#5CCC96"
        },
        "string.regex": {
          "color": "#5CCC96"
        },
        "string.special": {
          "color": "#F2CE00"
        },
        "string.special.symbol": {
          "color": "#F2CE00"
        },
        "tag": {
          "color": "#C86D8C"
        },
        "text.literal": {
          "color": "#ECF0C1"
        },
        "title": {
          "color": "#F2CE00",
          "font_weight": 600
        },
        "type": {
          "color": "#089CC5"
        },
        "property": {
          "color": "#ECF0C1"
        },
        "variable.special": {
          "color": "#C86D8C"
        }
      }
    }
  ]
}

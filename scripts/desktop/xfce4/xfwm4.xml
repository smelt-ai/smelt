<?xml version="1.0" encoding="UTF-8"?>
<!-- Smelt 远程桌面：最大化的窗口不画标题栏（Chrome 最大化后铺满停靠栏以上），只留一个
     工作区。合成器关着：没有显卡全靠 CPU，窗口一动就整片重绘，VNC 要传的变化也多；阴影、
     圆角、半透明都靠它，所以都没有。Default 窗口主题的配色跟着 GTK 主题（xsettings.xml）。 -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="titleless_maximize" type="bool" value="true"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="theme" type="string" value="Default"/>
    <property name="title_font" type="string" value="Noto Sans CJK SC Bold 9"/>
  </property>
</channel>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Smelt 远程桌面：终端深色配色、等宽字体，不要菜单栏和工具栏。xfce4-terminal 1.0 起
     设置存在这个频道里；更老的版本读 ~/.config/xfce4/terminal/terminalrc（install.sh 一起写，
     内容相同）。配色和桌面的深色主题对齐，不用纯黑。 -->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="DejaVu Sans Mono 11"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#dcdfe4"/>
  <property name="color-background" type="string" value="#1e2027"/>
  <property name="color-cursor" type="string" value="#dcdfe4"/>
  <property name="color-palette" type="string" value="#282c34;#e06c75;#98c379;#e5c07b;#61afef;#c678dd;#56b6c2;#dcdfe4;#5c6370;#e06c75;#98c379;#e5c07b;#61afef;#c678dd;#56b6c2;#ffffff"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-toolbar-default" type="bool" value="false"/>
  <property name="misc-cursor-blinks" type="bool" value="false"/>
  <property name="scrolling-bar" type="string" value="TERMINAL_SCROLLBAR_NONE"/>
</channel>

# Smelt 远程桌面的窗口主题：深色标题栏、上方圆角、左边红黄绿三个按钮，配色同 macOS 深色
# 模式。图片由 scripts/make-desktop-theme.py 生成，install.sh 装到
# ~/.local/share/themes/Smelt/xfwm4/。
#
# 按钮 20px 宽、圆在正中，所以不另留间距；第一个按钮离边 9px，不压住 10px 的圆角。
# 标题对整条标题栏居中，不是对按钮右边剩下的那段。
active_text_color=#e5e5e7
inactive_text_color=#8d8d92
title_alignment=center
full_width_title=true
button_offset=9
button_spacing=0
title_vertical_offset_active=0
title_vertical_offset_inactive=0
title_shadow_active=false
title_shadow_inactive=false
maximized_offset=0
# 合成器画的阴影往下偏一点，同 macOS。
shadow_delta_x=0
shadow_delta_y=4
shadow_delta_width=0
shadow_delta_height=0

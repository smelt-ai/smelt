// Copy this file to Developer.xcconfig and use your own Apple Developer Team
// and a Bundle ID registered by that team. Developer.xcconfig is gitignored.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = ai.smelt.mobile.yourname

// Optional: push notifications need a relay holding an APNs key of YOUR team
// (docs/push-relay-deployment.md). Host only, no scheme.
// SMELT_PUSH_RELAY_HOST = push.example.com

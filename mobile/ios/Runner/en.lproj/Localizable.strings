/* Push notification text (smelt-push PushKind::loc_key / detail_loc_key). The title and
   subtitle are the session and project names; the body is one of these, so iOS shows the
   kind of alert in the phone's language. %@ is a one-line summary: the command waiting
   for approval, the question, the failure, or the start of the agent's last reply. */
"SMELT_PUSH_APPROVAL" = "An agent is waiting for your approval";
"SMELT_PUSH_INPUT" = "An agent is waiting for your reply";
"SMELT_PUSH_FAILURE" = "An agent run failed";
"SMELT_PUSH_SUCCESS" = "An agent finished";
"SMELT_PUSH_MESSAGE" = "An agent sent you a message";
"SMELT_PUSH_APPROVAL_DETAIL" = "Needs approval: %@";
"SMELT_PUSH_INPUT_DETAIL" = "Waiting for you: %@";
"SMELT_PUSH_FAILURE_DETAIL" = "Failed: %@";
"SMELT_PUSH_SUCCESS_DETAIL" = "Done: %@";
